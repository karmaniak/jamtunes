# Operator-side AI configuration. Users never configure anything.
#
# Default: Anthropic, Claude Haiku 5.5 — about $0.0004 per chat request
# (~2,500 requests per dollar). Create a key at https://console.anthropic.com
# and set it here or in your host's environment variables.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# AI_MODEL=claude-haiku-5-5            # or claude-sonnet-5-5 / claude-opus-5-5 for better answers at higher cost
# AI_PROVIDER=anthropic                # or: openai-compatible (HF router, vLLM, Ollama, Together, Groq…)
# AI_BASE_URL=https://router.huggingface.co/v1   # openai-compatible only
# AI_API_KEY=                          # openai-compatible only (HF_TOKEN also works)
# AI_TIMEOUT_MS=20000
# AI_DEBUG=1                           # log model replies on the server when diagnosing

# Spend brakes
# AI_LIMIT_PER_MINUTE=10               # per device
# AI_LIMIT_PER_DAY=60                  # per device
# AI_GLOBAL_PER_DAY=5000               # everyone combined, per server instance (~$2/day on Haiku)
# AI_MAX_MESSAGE_CHARS=2000

# Local dev server port (vite proxies /api here)
PORT=8787
