# Operator-side AI configuration. Users never configure anything.
# Default provider: Hugging Face's OpenAI-compatible router with an open instruct model.
# Create a token at https://huggingface.co/settings/tokens and set it here (or in your host's env).
HF_TOKEN=

# Optional overrides (defaults shown)
# AI_PROVIDER=openai-compatible        # or: anthropic
# AI_BASE_URL=https://router.huggingface.co/v1
# AI_MODEL=Qwen/Qwen2.5-7B-Instruct    # any chat model the endpoint serves
# AI_API_KEY=                          # if not using HF_TOKEN (vLLM, Together, Groq, Ollama…)
# AI_TIMEOUT_MS=20000

# Anthropic instead (AI_PROVIDER=anthropic); model defaults to claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Free-tier limits per device
# AI_LIMIT_PER_MINUTE=10
# AI_LIMIT_PER_DAY=60
# AI_MAX_MESSAGE_CHARS=2000

# Local dev server port (vite proxies /api here)
PORT=8787
